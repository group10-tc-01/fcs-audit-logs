{
  "KafkaSettings": {
    "BootstrapServers": "kafka:29092",
    "GroupId": "fcs-audit-logs-consumer-group",
    "ConsumerTimeoutMs": 100,
    "Topics": {
      "AuditLogRequested": "audit-log-requested"
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "mongodb://mongodb:27017",
    "DatabaseName": "AuditLogsDb",
    "CollectionName": "audit_logs"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ]
  }
}
